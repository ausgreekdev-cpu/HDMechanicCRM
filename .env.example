# HDMechanicCRM Environment Variables
# Copy this file to .env and fill in your values

# REQUIRED: Secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
CRM_SECRET_KEY=change-me-to-a-random-64-char-string

# Admin credentials (auto-created on first run)
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Database (default: SQLite at data/crm.db)
# For PostgreSQL: postgresql://user:pass@localhost:5432/hdmechanic
CRM_DATABASE_URL=

# Flask Debug Mode (set to 1 for development, 0 for production)
FLASK_DEBUG=0

# Server
CRM_PORT=8000
CRM_GUNICORN_WORKERS=4
CRM_GUNICORN_TIMEOUT=120

# Logging
CRM_LOG_LEVEL=INFO
CRM_LOG_FILE=

# Redis (for rate limiting, caching, session storage)
# Default: redis://localhost:6379/0
CRM_REDIS_URL=redis://localhost:6379/0

# Square Payments (leave empty to run in demo mode - no real charges)
CRM_SQUARE_ENVIRONMENT=sandbox
CRM_SQUARE_APPLICATION_ID=
CRM_SQUARE_ACCESS_TOKEN=
CRM_SQUARE_LOCATION_ID=
CRM_SQUARE_WEBHOOK_SIGNATURE_KEY=
CRM_SQUARE_CURRENCY=AUD

# Seeding: set to 1 to create demo customers/vehicles on startup (local only)
CRM_SEED_DEMO=

# Twilio SMS (optional)
CRM_TWILIO_SID=
CRM_TWILIO_AUTH=
CRM_TWILIO_PHONE=

# SMTP Configuration (optional - for email notifications)
CRM_SMTP_SERVER=
CRM_SMTP_PORT=587
CRM_SMTP_USERNAME=
CRM_SMTP_PASSWORD=
CRM_SMTP_FROM=noreply@yourdomain.com

# Backup Configuration
# S3-compatible storage (AWS S3, MinIO, Cloudflare R2, etc.)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=hdmechaniccrm/backups/
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_RETENTION_DAYS=30